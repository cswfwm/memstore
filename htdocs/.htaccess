AddDefaultCharset UTF-8
AddType "text/markdown; charset=UTF-8" .md
AddType "application/json; charset=UTF-8" .json

Options -Indexes

<FilesMatch "^config(\.sample)?\.php$">
    Require all denied
</FilesMatch>

# 压缩文本响应，减少传输字节（不减少 hits）
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/markdown text/css application/json text/xml application/xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
